{
  "name": "aikata-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:ios-avatar": "esbuild src/ios-avatar/entry.ts --bundle --format=iife --target=es2019 --minify --outfile=public/ios-avatar/avatar.bundle.js",
    "build": "npm run build:ios-avatar && tsc -b && vite build && rm -f ../backend/static/models/realistic.vrm",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.3",
    "@pixiv/three-vrm-animation": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  }
}
