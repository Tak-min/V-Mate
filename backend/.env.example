# === クラウド構成(ローカル実行なし)===

# LLM — OpenAI互換 Chat Completions。既定は Groq(無料・高速)。
# base_url を差し替えるだけで Cerebras / OpenRouter 等へ移行可能。
LLM_BASE_URL=https://api.groq.com/openai/v1
# 日本語重視なら qwen/qwen3-32b 等に変更(モデルIDは各プロバイダの一覧で確認)。
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# 音声合成 (ElevenLabs)。未設定なら音声は無効(テキストのみ)。
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2
