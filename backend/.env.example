# LLM プロバイダ: auto | ollama | gemini
# auto = GEMINI_API_KEY があれば Gemini、なければ Ollama(ローカル)
AIKATA_PROVIDER=auto

# Gemini (任意 — 無くてもOllamaで動く)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (ローカルLLM)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# AivisSpeech Engine (任意 — 無ければブラウザ音声にフォールバック)
AIVIS_URL=http://127.0.0.1:10101
AIVIS_SPEAKER=888753760
