# === Aikata 設定(クラウド構成・マルチユーザー公開対応)===

# --- LLM(必須)--- OpenAI互換 Chat Completions。既定は Groq(無料・高速)。
# base_url を差し替えるだけで Cerebras / OpenRouter 等へ移行可能。
LLM_BASE_URL=https://api.groq.com/openai/v1
# 日本語重視なら qwen/qwen3-32b 等(モデルIDは各プロバイダの一覧で確認)。
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# --- DB --- 未設定ならローカルSQLite。本番は Neon 等の Postgres を指定。
# 例: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# --- 認証(本番必須)--- JWT 署名鍵。32文字以上のランダム文字列を設定すること。
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- 音声合成(任意)--- Aivis Cloud API (AivisSpeech)。ENABLE_TTS=true のときだけ使う。
# 公開では無料枠が小さいため既定オフ(ENABLE_TTS 未設定=オフ)。
# キー取得: https://hub.aivis-project.com/cloud-api/api-keys
ENABLE_TTS=false
AIVIS_API_KEY=
AIVIS_MODEL_UUID=a59cb814-0083-4369-8542-f51a29e72af7
AIVIS_SPEAKER_UUID=
AIVIS_STYLE_NAME=

# --- レート制限(公開時のコスト・不正利用対策)---
RATE_PER_USER_PER_DAY=50
RATE_GLOBAL_PER_DAY=800
RATE_LOGIN_PER_IP_PER_DAY=30

# --- 研究モード ---
# URL の ?condition=text|stylized|realistic による条件指定を許可する。
# 本実験で完全な無作為割付だけにしたい場合は false。
RESEARCH_ALLOW_CONDITION_OVERRIDE=true
# /api/research/export を使う場合のみ設定する秘密トークン。
RESEARCH_EXPORT_TOKEN=

# --- CORS --- 別オリジンのフロントを許可する場合のみ(カンマ区切り)。
# 同一オリジン配信(既定)なら不要。
CORS_ORIGINS=
