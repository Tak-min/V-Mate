{
  // シロ(Aikata)— 全Cloudflare 構成(Worker + D1 + 静的アセット同居)。
  // デプロイ: cd worker && npm i && npm run db:init:remote && npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aikata",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",

  // 静的フロント(Vite ビルド成果物)を同一オリジンで配信する。
  // /api/*、/models/realistic.vrm(R2配信、25MiB超のため静的アセットに置けない)、
  // /terms・/privacy(Worker内蔵の利用規約/プライバシーポリシー。frontendビルドで消えないよう
  // ここに置いている)は必ず Worker を先に実行し、それ以外は静的アセット→SPAフォールバック。
  "assets": {
    "directory": "../backend/static",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/models/realistic.vrm", "/terms", "/privacy"]
  },

  // R2(オブジェクトストレージ)。Workers静的アセットは1ファイル25MiB上限のため、
  // それを超える大型VRM(realistic.vrm)はここに置き、Worker側でstreamして配信する。
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "aikata-models"
    }
  ],

  // D1(SQLite・無料・永続)。database_id は `wrangler d1 create aikata` で発行された値に置き換える。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aikata",
      "database_id": "235e7390-c238-4f6d-8568-d30899db71f0"
    }
  ],

  // 機密でない設定。秘密(LLM_API_KEY / JWT_SECRET / AIVIS_API_KEY /
  // REVENUECAT_WEBHOOK_AUTH / REVENUECAT_SECRET_API_KEY)は
  // `wrangler secret put <NAME>` で登録する(ここには書かない)。
  "vars": {
    "LLM_BASE_URL": "https://api.groq.com/openai/v1",
    // 2026-07-05: llama-3.3-70b-versatile から移行。コスト約1/5・速度約1.5倍。
    // 品質が不十分なら "llama-3.3-70b-versatile" に戻す(1行変更でロールバック可能)。
    "LLM_MODEL": "meta-llama/llama-4-scout-17b-16e-instruct",
    "ENABLE_TTS": "true",
    "RATE_PER_USER_PER_DAY": "50",
    "RATE_GLOBAL_PER_DAY": "800",
    "RATE_LOGIN_PER_IP_PER_DAY": "30",
    "APPLE_BUNDLE_ID": "com.takmin.vmate",
    // RevenueCat の Sandbox 購入は誰でも無料で作れるため、本番Workerは webhook の environment が
    // "Production" と厳密一致しない限り権利を付与しない(fail-closed、revenuecat.ts)。
    // TestFlight/Sandbox の end-to-end 検証時のみ、そのデプロイで一時的に "Sandbox" へ差し替える。
    "REVENUECAT_ENVIRONMENT": "Production",
    // Pro(subscription:pro)エンタイトルメント保持者のクォータ。事業判断で調整可能な値であり、
    // ここを変える以外のコード変更は不要(index.ts の enforceRateLimit/getTts/generateDiary参照)。
    "RATE_PRO_PER_USER_PER_DAY": "500",
    "RATE_TTS_PER_USER_PER_DAY": "30",
    "RATE_TTS_PRO_PER_USER_PER_DAY": "300",
    "RATE_DIARY_FREE_PER_WEEK": "2"
  },

  "observability": {
    "enabled": true
  }
}
