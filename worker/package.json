{
  "name": "aikata-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "シロ(Aikata)バックエンド — Cloudflare Workers + D1 版(全Cloudflare・無料・永続)",
  "scripts": {
    "build:frontend": "npm --prefix ../frontend run build",
    "dev": "wrangler dev",
    "pretest": "npm run cf-typegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run cf-typegen",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute aikata --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute aikata --remote --file=./schema.sql",
    "deploy": "npm run build:frontend && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@peculiar/x509": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "~5.6.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.101.0"
  },
  "dependencies": {
    "asn1js": "^3.0.10",
    "pkijs": "^3.4.0"
  }
}
